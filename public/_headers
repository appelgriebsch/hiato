# HTML entry: always revalidate so clients pick up new SW registration
/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

# Service worker + webmanifest: always revalidate (ADR 0011)
/sw.js
  Cache-Control: no-cache

/workbox-*.js
  Cache-Control: no-cache

/manifest.webmanifest
  Cache-Control: no-cache

# Hashed Vite assets: immutable long-cache
/assets/*
  Cache-Control: public, max-age=31536000, immutable
