# Security headers on every response (H1). More specific rules below override Cache-Control.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data: blob:; connect-src 'self'; worker-src 'self'; manifest-src 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; frame-ancestors 'none'

# HTML entry: always revalidate so clients pick up new SW registration
/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

# Service worker + webmanifest: always revalidate (ADR 0011)
/sw.js
  Cache-Control: no-cache

/workbox-*.js
  Cache-Control: no-cache

/manifest.webmanifest
  Cache-Control: no-cache

# Learner packs: revalidate so clients pick up version bumps (ADR 0006)
/packs/*
  Cache-Control: public, max-age=0, must-revalidate

# Social banner: crawlers fetch this as a document navigation in some clients
/og-banner.png
  Cache-Control: public, max-age=86400

# Hashed Vite assets: immutable long-cache
/assets/*
  Cache-Control: public, max-age=31536000, immutable
