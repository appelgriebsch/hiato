{
  "name": "hiato",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "bun run scripts/write-build-sha.ts && bun run packs:check && tsc -b && vite build",
    "lint": "oxlint --deny-warnings",
    "licenses:check": "license-checker-rseidelsohn --production --excludePrivatePackages --summary --onlyAllow \"MIT;ISC;Apache-2.0;BSD-2-Clause;BSD-3-Clause;OFL-1.1;MPL-2.0;0BSD;BlueOak-1.0.0;CC0-1.0;Python-2.0;MIT OR Apache-2.0;CC-BY-4.0;Unlicense\"",
    "preview": "vite preview",
    "test": "bun test",
    "packs:check": "bun run scripts/packs-check.ts",
    "packs:expand": "bun run scripts/expand-packs.ts --levels=b2,c1,c2",
    "packs:hint-ceiling-data": "bun run scripts/build-hint-ceiling-data.ts"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "dictionary-de": "3.0.0",
    "dictionary-en": "4.0.0",
    "dictionary-es": "4.0.0",
    "dictionary-fr": "3.0.0",
    "dictionary-it": "2.0.0",
    "dictionary-pt": "4.0.0",
    "dictionary-pt-pt": "2.0.0",
    "license-checker-rseidelsohn": "4.4.2",
    "nspell": "2.1.5",
    "oxlint": "1.90.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "wrangler": "4.136.2"
  },
  "packageManager": "bun@1.4.4",
  "trustedDependencies": [],
  "engines": {
    "node": ">=22.23.4 <23"
  }
}
